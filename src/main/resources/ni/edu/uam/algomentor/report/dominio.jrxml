<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="constancia_dominio_algomentor"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="30"
              bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="perfilNombre" class="java.lang.String"/>
    <parameter name="algoritmoNombre" class="java.lang.String"/>
    <parameter name="fechaGeneracion" class="java.lang.String"/>
    <parameter name="descripcion" class="java.lang.String"/>
    <parameter name="intentos" class="java.lang.Long"/>
    <parameter name="correctos" class="java.lang.Long"/>
    <parameter name="porcentaje" class="java.lang.String"/>
    <parameter name="umbral" class="java.lang.String"/>
    <parameter name="domina" class="java.lang.Boolean"/>
    <parameter name="mensajePlan" class="java.lang.String"/>
    <detail>
        <band height="730">
            <element kind="rectangle" x="0" y="0" width="515" height="730"
                     mode="Opaque" backcolor="#F8FAFC" forecolor="#F8FAFC"/>
            <element kind="rectangle" x="0" y="0" width="515" height="148"
                     mode="Opaque" backcolor="#0F172A" forecolor="#0F172A"/>
            <element kind="rectangle" x="0" y="142" width="515" height="6"
                     mode="Opaque" backcolor="#14B8A6" forecolor="#14B8A6"/>
            <element kind="textField" x="32" y="28" width="451" height="24"
                     fontSize="11.0" bold="true" forecolor="#99F6E4"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA["ALGOMENTOR  ·  RECONOCIMIENTO DE APRENDIZAJE"]]></expression>
            </element>
            <element kind="textField" x="32" y="65" width="451" height="48"
                     fontSize="25.0" bold="true" forecolor="#FFFFFF"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$P{domina} ? "CONSTANCIA DE DOMINIO" : "PLAN PERSONALIZADO"]]></expression>
            </element>
            <element kind="textField" x="35" y="178" width="445" height="24"
                     fontSize="11.0" forecolor="#64748B"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$P{domina} ? "Se reconoce que" : "Dirigido a"]]></expression>
            </element>
            <element kind="textField" x="35" y="210" width="445" height="38"
                     fontSize="23.0" bold="true" forecolor="#0F172A"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$P{perfilNombre}]]></expression>
            </element>
            <element kind="textField" x="35" y="263" width="445" height="25"
                     fontSize="12.0" forecolor="#475569"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$P{domina} ? "domina el algoritmo" : "continúe practicando"]]></expression>
            </element>
            <element kind="textField" x="25" y="300" width="465" height="48"
                     fontSize="25.0" bold="true" forecolor="#0F766E"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[($P{domina} ? "Domina " : "Practica ") + $P{algoritmoNombre}]]></expression>
            </element>
            <element kind="textField" x="45" y="358" width="425" height="42"
                     fontSize="10.0" forecolor="#475569"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$P{descripcion}]]></expression>
            </element>
            <element kind="rectangle" x="50" y="428" width="415" height="92"
                     mode="Opaque" backcolor="#FFFFFF" forecolor="#CCFBF1"/>
            <element kind="textField" x="65" y="440" width="385" height="18"
                     fontSize="9.0" bold="true" forecolor="#0F766E"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$P{domina} ? "RESULTADO DE APRENDIZAJE" : "TU PROGRESO ACTUAL"]]></expression>
            </element>
            <element kind="textField" x="65" y="465" width="385" height="38"
                     fontSize="20.0" bold="true" forecolor="#0F172A"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$P{porcentaje} + " de aciertos  ·  " + $P{correctos} + " / " + $P{intentos} + " intentos"]]></expression>
            </element>
            <element kind="textField" x="45" y="535" width="425" height="26"
                     fontSize="10.0" forecolor="#64748B"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA["Umbral de dominio: " + $P{umbral}]]></expression>
            </element>
            <element kind="rectangle" x="36" y="575" width="443" height="104"
                     mode="Opaque" backcolor="#ECFDF5" forecolor="#99F6E4">
                <printWhenExpression><![CDATA[!$P{domina}]]></printWhenExpression>
            </element>
            <element kind="textField" x="52" y="585" width="410" height="82"
                     fontSize="10.0" forecolor="#134E4A" vTextAlign="Middle"
                     textAdjust="StretchHeight">
                <printWhenExpression><![CDATA[!$P{domina}]]></printWhenExpression>
                <expression><![CDATA[$P{mensajePlan}]]></expression>
            </element>
            <element kind="textField" x="40" y="692" width="435" height="18"
                     fontSize="8.0" forecolor="#64748B"
                     hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA["Generado el " + $P{fechaGeneracion}]]></expression>
            </element>
        </band>
    </detail>
</jasperReport>
