<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="progreso_algomentor"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="36"
              bottomMargin="32"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="perfilNombre" class="java.lang.String"/>
    <parameter name="fechaGeneracion" class="java.lang.String"/>
    <parameter name="totalIntentos" class="java.lang.Long"/>
    <parameter name="intentosCorrectos" class="java.lang.Long"/>
    <parameter name="intentosIncorrectos" class="java.lang.Long"/>
    <parameter name="intentosSinCalificar" class="java.lang.Long"/>
    <parameter name="porcentajeAcierto" class="java.lang.String"/>
    <parameter name="rachaActual" class="java.lang.Long"/>
    <parameter name="tiempoPromedio" class="java.lang.String"/>
    <parameter name="algoritmosUsados" class="java.lang.Long"/>
    <field name="seccion" class="java.lang.String"/>
    <field name="tituloSeccion" class="java.lang.String"/>
    <field name="h1" class="java.lang.String"/>
    <field name="h2" class="java.lang.String"/>
    <field name="h3" class="java.lang.String"/>
    <field name="h4" class="java.lang.String"/>
    <field name="h5" class="java.lang.String"/>
    <field name="c1" class="java.lang.String"/>
    <field name="c2" class="java.lang.String"/>
    <field name="c3" class="java.lang.String"/>
    <field name="c4" class="java.lang.String"/>
    <field name="c5" class="java.lang.String"/>
    <group name="seccion" minHeightToStartNewPage="90">
        <expression><![CDATA[$F{seccion}]]></expression>
        <groupHeader>
            <band height="66">
                <element kind="textField" x="0" y="8" width="515" height="20"
                         fontSize="13.0" bold="true" forecolor="#0F172A" vTextAlign="Middle">
                    <expression><![CDATA[$F{tituloSeccion}]]></expression>
                </element>
                <element kind="rectangle" x="0" y="34" width="515" height="28"
                         mode="Opaque" backcolor="#1E3A5F" forecolor="#1E3A5F"/>
                <element kind="textField" x="12" y="34" width="143" height="28"
                         fontSize="9.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle">
                    <expression><![CDATA[$F{h1}]]></expression>
                </element>
                <element kind="textField" x="155" y="34" width="105" height="28"
                         fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle">
                    <expression><![CDATA[$F{h2}]]></expression>
                </element>
                <element kind="textField" x="260" y="34" width="85" height="28"
                         fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle">
                    <expression><![CDATA[$F{h3}]]></expression>
                </element>
                <element kind="textField" x="345" y="34" width="85" height="28"
                         fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle">
                    <expression><![CDATA[$F{h4}]]></expression>
                </element>
                <element kind="textField" x="430" y="34" width="85" height="28"
                         fontSize="9.0" bold="true" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle">
                    <expression><![CDATA[$F{h5}]]></expression>
                </element>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="12"/>
        </groupFooter>
    </group>
    <title height="206">
        <element kind="rectangle" x="0" y="0" width="515" height="58"
                 mode="Opaque" backcolor="#0F172A" forecolor="#0F172A"/>
        <element kind="textField" x="18" y="10" width="479" height="27"
                 fontSize="20.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle">
            <expression><![CDATA["AlgoMentor | Informe de progreso"]]></expression>
        </element>
        <element kind="textField" x="19" y="38" width="479" height="15"
                 fontSize="9.0" forecolor="#BAE6FD" vTextAlign="Middle">
            <expression><![CDATA["RESUMEN DE APRENDIZAJE"]]></expression>
        </element>
        <element kind="textField" x="0" y="68" width="330" height="20"
                 fontSize="12.0" bold="true" forecolor="#0F172A" vTextAlign="Middle">
            <expression><![CDATA[$P{perfilNombre}]]></expression>
        </element>
        <element kind="textField" x="330" y="68" width="185" height="20"
                 fontSize="9.0" forecolor="#475569" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["Generado el " + $P{fechaGeneracion}]]></expression>
        </element>
        <element kind="rectangle" x="0" y="96" width="123" height="48"
                 mode="Opaque" backcolor="#F1F5F9" forecolor="#F1F5F9"/>
        <element kind="rectangle" x="131" y="96" width="123" height="48"
                 mode="Opaque" backcolor="#ECFDF5" forecolor="#ECFDF5"/>
        <element kind="rectangle" x="262" y="96" width="123" height="48"
                 mode="Opaque" backcolor="#FFF7ED" forecolor="#FFF7ED"/>
        <element kind="rectangle" x="393" y="96" width="122" height="48"
                 mode="Opaque" backcolor="#F8FAFC" forecolor="#F8FAFC"/>
        <element kind="textField" x="10" y="101" width="103" height="14"
                 fontSize="8.0" forecolor="#475569" vTextAlign="Middle">
            <expression><![CDATA["INTENTOS"]]></expression>
        </element>
        <element kind="textField" x="10" y="116" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#0F172A" vTextAlign="Middle">
            <expression><![CDATA[$P{totalIntentos}]]></expression>
        </element>
        <element kind="textField" x="141" y="101" width="103" height="14"
                 fontSize="8.0" forecolor="#166534" vTextAlign="Middle">
            <expression><![CDATA["CORRECTOS"]]></expression>
        </element>
        <element kind="textField" x="141" y="116" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#166534" vTextAlign="Middle">
            <expression><![CDATA[$P{intentosCorrectos}]]></expression>
        </element>
        <element kind="textField" x="272" y="101" width="103" height="14"
                 fontSize="8.0" forecolor="#9A3412" vTextAlign="Middle">
            <expression><![CDATA["INCORRECTOS"]]></expression>
        </element>
        <element kind="textField" x="272" y="116" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#9A3412" vTextAlign="Middle">
            <expression><![CDATA[$P{intentosIncorrectos}]]></expression>
        </element>
        <element kind="textField" x="403" y="101" width="103" height="14"
                 fontSize="8.0" forecolor="#475569" vTextAlign="Middle">
            <expression><![CDATA["SIN CALIFICAR"]]></expression>
        </element>
        <element kind="textField" x="403" y="116" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#0F172A" vTextAlign="Middle">
            <expression><![CDATA[$P{intentosSinCalificar}]]></expression>
        </element>
        <element kind="rectangle" x="0" y="152" width="123" height="48"
                 mode="Opaque" backcolor="#EFF6FF" forecolor="#EFF6FF"/>
        <element kind="rectangle" x="131" y="152" width="123" height="48"
                 mode="Opaque" backcolor="#F5F3FF" forecolor="#F5F3FF"/>
        <element kind="rectangle" x="262" y="152" width="123" height="48"
                 mode="Opaque" backcolor="#F0FDFA" forecolor="#F0FDFA"/>
        <element kind="rectangle" x="393" y="152" width="122" height="48"
                 mode="Opaque" backcolor="#F8FAFC" forecolor="#F8FAFC"/>
        <element kind="textField" x="10" y="157" width="103" height="14"
                 fontSize="8.0" forecolor="#1E40AF" vTextAlign="Middle">
            <expression><![CDATA["ACIERTO"]]></expression>
        </element>
        <element kind="textField" x="10" y="172" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#1E40AF" vTextAlign="Middle">
            <expression><![CDATA[$P{porcentajeAcierto}]]></expression>
        </element>
        <element kind="textField" x="141" y="157" width="103" height="14"
                 fontSize="8.0" forecolor="#5B21B6" vTextAlign="Middle">
            <expression><![CDATA["RACHA DE ACIERTOS"]]></expression>
        </element>
        <element kind="textField" x="141" y="172" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#5B21B6" vTextAlign="Middle">
            <expression><![CDATA[$P{rachaActual}]]></expression>
        </element>
        <element kind="textField" x="272" y="157" width="103" height="14"
                 fontSize="8.0" forecolor="#115E59" vTextAlign="Middle">
            <expression><![CDATA["TIEMPO PROMEDIO"]]></expression>
        </element>
        <element kind="textField" x="272" y="172" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#115E59" vTextAlign="Middle">
            <expression><![CDATA[$P{tiempoPromedio}]]></expression>
        </element>
        <element kind="textField" x="403" y="157" width="103" height="14"
                 fontSize="8.0" forecolor="#475569" vTextAlign="Middle">
            <expression><![CDATA["ALGORITMOS USADOS"]]></expression>
        </element>
        <element kind="textField" x="403" y="172" width="103" height="23"
                 fontSize="17.0" bold="true" forecolor="#0F172A" vTextAlign="Middle">
            <expression><![CDATA[$P{algoritmosUsados}]]></expression>
        </element>
    </title>
    <detail>
        <band height="26">
            <element kind="rectangle" x="0" y="0" width="515" height="26"
                     mode="Opaque" backcolor="#F8FAFC" forecolor="#F8FAFC"/>
            <element kind="line" x="0" y="25" width="515" height="0"
                     forecolor="#E2E8F0"/>
            <element kind="textField" x="12" y="0" width="143" height="26"
                     fontSize="9.0" forecolor="#1E293B" vTextAlign="Middle">
                <expression><![CDATA[$F{c1}]]></expression>
            </element>
            <element kind="textField" x="155" y="0" width="105" height="26"
                     fontSize="9.0" forecolor="#1E293B" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{c2}]]></expression>
            </element>
            <element kind="textField" x="260" y="0" width="85" height="26"
                     fontSize="9.0" forecolor="#1E293B" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{c3}]]></expression>
            </element>
            <element kind="textField" x="345" y="0" width="85" height="26"
                     fontSize="9.0" forecolor="#1E293B" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{c4}]]></expression>
            </element>
            <element kind="textField" x="430" y="0" width="85" height="26"
                     fontSize="9.0" bold="true" forecolor="#1E3A5F" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{c5}]]></expression>
            </element>
        </band>
    </detail>
    <pageFooter height="22">
        <element kind="line" x="0" y="0" width="515" height="0"
                 forecolor="#CBD5E1"/>
        <element kind="textField" x="0" y="4" width="400" height="16"
                 fontSize="8.0" forecolor="#64748B" vTextAlign="Middle">
            <expression><![CDATA["AlgoMentor · Progreso de aprendizaje"]]></expression>
        </element>
        <element kind="textField" x="400" y="4" width="115" height="16"
                 fontSize="8.0" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
    <noData height="52">
        <element kind="rectangle" x="0" y="0" width="515" height="44"
                 mode="Opaque" backcolor="#F1F5F9" forecolor="#F1F5F9"/>
        <element kind="textField" x="14" y="8" width="487" height="28"
                 fontSize="10.0" forecolor="#475569" vTextAlign="Middle">
            <expression><![CDATA["Aún no hay datos para este perfil. Resuelve ejercicios en Práctica para ver el detalle aquí."]]></expression>
