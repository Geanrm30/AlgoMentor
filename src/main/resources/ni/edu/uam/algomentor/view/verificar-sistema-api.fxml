<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.algomentor.controller.VerificarSistemaApiController">
    <content>
        <VBox spacing="18" styleClass="tab-content">
            <VBox spacing="12" styleClass="card">
                <Label text="Verificar un sistema lineal" styleClass="section-title" />
                <Label text="Escribe una matriz ampliada cuadrada. Una ecuación por línea y valores separados por comas."
                       wrapText="true" />
                <TextArea fx:id="txtMatriz" prefRowCount="5" promptText="2, 1, 5&#10;1, -1, 1"
                          accessibleText="Matriz ampliada del sistema" />
                <Button fx:id="btnConsultar" text="Resolver y consultar" onAction="#consultar"
                        styleClass="primary-button" />
            </VBox>
            <VBox spacing="10" styleClass="card">
                <Label text="Resultados" styleClass="section-title" />
                <Label fx:id="lblLocal" wrapText="true" />
                <Label fx:id="lblExterno" wrapText="true" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
