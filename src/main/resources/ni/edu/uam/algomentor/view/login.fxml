<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="raiz" styleClass="login-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.LoginController">
    <StackPane fx:id="tarjeta" prefWidth="420" maxWidth="420" maxHeight="-Infinity" styleClass="login-card">
        <VBox fx:id="contenido" spacing="14">
            <HBox fx:id="cabecera" spacing="10" alignment="CENTER_LEFT" />
            <VBox spacing="4">
                <Label fx:id="lblTitulo" text="Bienvenido de nuevo" styleClass="login-titulo" wrapText="true" />
                <Label fx:id="lblSubtitulo" styleClass="subtitle" wrapText="true" />
            </VBox>
            <VBox fx:id="contenedorFormulario" />
            <Button fx:id="btnModo" styleClass="enlace-login" maxWidth="Infinity" />
            <Label fx:id="lblEstado" wrapText="true" />
        </VBox>
    </StackPane>
</StackPane>
