<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.ResumenController">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Resumen general (administración)" styleClass="section-title" />
            <Label text="Contenido y actividad de todos los perfiles. Solo visible para administradores." wrapText="true" />
        </VBox>
        <Button fx:id="btnActualizar" text="Actualizar" onAction="#cargarResumen" />
    </HBox>
    <HBox spacing="12">
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-icono, chip-violeta"><Region styleClass="ico, ico-lista" /></StackPane>
            <VBox spacing="2">
                <Label fx:id="lblCantidadAlgoritmos" text="—" styleClass="summary-value" />
                <Label text="Algoritmos" styleClass="summary-label" />
            </VBox>
        </HBox>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-icono, chip-azul"><Region styleClass="ico, ico-lapiz" /></StackPane>
            <VBox spacing="2">
                <Label fx:id="lblCantidadEjercicios" text="—" styleClass="summary-value" />
                <Label text="Ejercicios" styleClass="summary-label" />
            </VBox>
        </HBox>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-icono, chip-verde"><Region styleClass="ico, ico-usuario" /></StackPane>
            <VBox spacing="2">
                <Label fx:id="lblCantidadPerfiles" text="—" styleClass="summary-value" />
                <Label text="Perfiles" styleClass="summary-label" />
            </VBox>
        </HBox>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="summary-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="chip-icono, chip-violeta"><Region styleClass="ico, ico-lapiz" /></StackPane>
            <VBox spacing="2">
                <Label fx:id="lblCantidadIntentos" text="—" styleClass="summary-value" />
                <Label text="Intentos" styleClass="summary-label" />
            </VBox>
        </HBox>
    </HBox>
    <TabPane VBox.vgrow="ALWAYS" styleClass="content-tabs">
        <tabs>
            <Tab text="Gráficos" closable="false">
                <content>
                    <VBox spacing="10" styleClass="tab-content">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Gráfico:" />
                            <ComboBox fx:id="cmbGrafico" prefWidth="340" />
                        </HBox>
                        <StackPane VBox.vgrow="ALWAYS" minHeight="320">
                            <PieChart fx:id="graficoEjerciciosAlgoritmo" animated="false" labelsVisible="false" legendVisible="true" legendSide="RIGHT" />
                            <BarChart fx:id="graficoEjerciciosDificultad" animated="false" legendVisible="false" visible="false" managed="false">
                                <xAxis>
                                    <CategoryAxis fx:id="axisDificultad" label="Dificultad" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="axisCantidadEjercicios" label="Ejercicios" forceZeroInRange="true" minorTickCount="0" />
                                </yAxis>
                            </BarChart>
                            <PieChart fx:id="graficoEjerciciosOrigen" animated="false" labelsVisible="false" legendVisible="true" legendSide="RIGHT" visible="false" managed="false" />
                        </StackPane>
                    </VBox>
                </content>
            </Tab>
            <Tab text="Algoritmos" closable="false">
                <content>
                    <TableView fx:id="tablaAlgoritmos">
                        <columns>
                            <TableColumn fx:id="colAlgoritmoId" text="ID" prefWidth="70" />
                            <TableColumn fx:id="colAlgoritmoNombre" text="Nombre" prefWidth="240" />
                            <TableColumn fx:id="colAlgoritmoCategoria" text="Categoría" prefWidth="180" />
                            <TableColumn fx:id="colAlgoritmoComplejidad" text="Complejidad" prefWidth="150" />
                        </columns>
                    </TableView>
                </content>
            </Tab>
            <Tab text="Ejercicios" closable="false">
                <content>
                    <TableView fx:id="tablaEjercicios">
                        <columns>
                            <TableColumn fx:id="colEjercicioId" text="ID" prefWidth="65" />
                            <TableColumn fx:id="colEjercicioAlgoritmo" text="Algoritmo" prefWidth="190" />
                            <TableColumn fx:id="colEjercicioDificultad" text="Dificultad" prefWidth="100" />
                            <TableColumn fx:id="colEjercicioOrigen" text="Origen" prefWidth="130" />
                            <TableColumn fx:id="colEjercicioDatos" text="Datos" prefWidth="390" />
                        </columns>
                    </TableView>
                </content>
            </Tab>
            <Tab text="Perfiles" closable="false">
                <content>
                    <VBox spacing="10" styleClass="tab-content">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Selecciona un perfil para revisar su avance." maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnVerProgresoPerfil" text="Ver progreso" onAction="#verProgresoPerfil" disable="true" />
                            <Button fx:id="btnExportarPerfil" text="Exportar informe" onAction="#exportarInformePerfil" disable="true" />
                        </HBox>
                        <TableView fx:id="tablaPerfiles" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colPerfilId" text="ID" prefWidth="90" />
                                <TableColumn fx:id="colPerfilNombre" text="Nombre" prefWidth="300" />
                                <TableColumn fx:id="colPerfilCreacion" text="Fecha de creación" prefWidth="190" />
                            </columns>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
            <Tab text="Ranking" closable="false">
                <content>
                    <VBox spacing="10" styleClass="tab-content">
                        <Label text="Ordenado por intentos correctos y luego por porcentaje de acierto (sobre los intentos calificados)." wrapText="true" />
                        <TableView fx:id="tablaRanking" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRankPuesto" text="#" prefWidth="60" />
                                <TableColumn fx:id="colRankPerfil" text="Perfil" prefWidth="240" />
                                <TableColumn fx:id="colRankIntentos" text="Intentos" prefWidth="100" />
                                <TableColumn fx:id="colRankCorrectos" text="Correctos" prefWidth="110" />
                                <TableColumn fx:id="colRankIncorrectos" text="Incorrectos" prefWidth="110" />
                                <TableColumn fx:id="colRankPorcentaje" text="Acierto %" prefWidth="120" />
                            </columns>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
    <Label fx:id="lblEstado" text="Listo" wrapText="true" />
</VBox>
