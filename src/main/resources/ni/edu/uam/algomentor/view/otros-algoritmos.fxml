<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.OtrosAlgoritmosController">
    <content>
        <VBox spacing="18" styleClass="tab-content">
            <VBox spacing="10" styleClass="card">
                <Label text="Búsqueda, grafos y recursividad" styleClass="section-title" />
                <ComboBox fx:id="cmbAlgoritmo" maxWidth="Infinity" accessibleText="Algoritmo" />
                <Label fx:id="lblDescripcion" wrapText="true" styleClass="mecanica-algoritmo" />
                <Label fx:id="lblDetalle" wrapText="true" styleClass="subtitle" />
                <TextField fx:id="txtEntrada" accessibleText="Entrada del algoritmo" />
                <Label fx:id="lblAyuda" wrapText="true" />
                <HBox spacing="10">
                    <Button text="Simular" onAction="#simular" styleClass="primary-button" />
                    <Button text="Usar ejemplo" onAction="#usarEjemplo" />
                </HBox>
            </VBox>
            <VBox spacing="12" styleClass="card">
                <Label text="Estado del algoritmo" styleClass="section-title" />
                <StackPane fx:id="escenario" minHeight="300" prefHeight="300" />
                <Label fx:id="lblPaso" text="Prepara una entrada para empezar." wrapText="true" />
                <Label fx:id="lblExplicacion" wrapText="true" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnAnterior" text="Anterior" onAction="#anterior" disable="true" />
                    <Button fx:id="btnSiguiente" text="Siguiente" onAction="#siguiente" disable="true" styleClass="primary-button" />
                    <Button fx:id="btnReproducir" text="Reproducir" onAction="#alternarReproduccion" disable="true" />
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
