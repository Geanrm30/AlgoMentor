<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.algomentor.controller.IntercambioEjerciciosController">
    <content>
        <VBox spacing="18" styleClass="tab-content">
            <VBox spacing="12" styleClass="card">
                <Label text="Exportar e importar ejercicios" styleClass="section-title" />
                <Label text="Exporta tus ejercicios a un archivo para pasarlos a otro equipo, o importa los que recibiste. Cada ejercicio debe usar un algoritmo que ya esté en el catálogo de AlgoMentor." wrapText="true" />
                <HBox spacing="10">
                    <Button fx:id="btnExportar" text="Exportar a archivo" onAction="#exportar" styleClass="primary-button" />
                    <Button fx:id="btnImportar" text="Importar desde archivo" onAction="#importar" />
                </HBox>
                <Label fx:id="lblEstado" wrapText="true" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
