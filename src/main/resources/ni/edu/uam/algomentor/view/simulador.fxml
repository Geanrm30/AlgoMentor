<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.SimuladorController">
    <content>
        <VBox spacing="18" styleClass="tab-content">
            <VBox spacing="10" styleClass="card">
                <Label text="Configura la simulación" styleClass="section-title" />
                <ComboBox fx:id="cmbAlgoritmo" maxWidth="Infinity" accessibleText="Algoritmo" />
                <TextField fx:id="txtArreglo" promptText="Ej. 8, 3, 6, 1" accessibleText="Números enteros separados por coma" />
                <VBox fx:id="entradaMatriz" />
                <Label fx:id="lblFormato" wrapText="true" />
                <Label fx:id="lblMecanica" wrapText="true" styleClass="mecanica-algoritmo" />
                <HBox spacing="10">
                    <Button text="Simular" onAction="#simular" styleClass="primary-button" />
                    <Button text="Generar entrada" onAction="#generarEntrada" />
                </HBox>
            </VBox>
            <GridPane fx:id="zonaEstado" hgap="18" vgap="18">
                <columnConstraints>
                    <ColumnConstraints fx:id="columnaEstado" hgrow="ALWAYS" minWidth="320" prefWidth="320" />
                    <ColumnConstraints fx:id="columnaPseudocodigo" hgrow="NEVER" minWidth="340" prefWidth="430" maxWidth="520" />
                </columnConstraints>
                <VBox spacing="12" styleClass="card" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="NEVER">
                    <Label text="Estado del algoritmo" styleClass="section-title" />
                    <Label text="Cian: elementos activos · Violeta: pivote de Quick Sort. Las escrituras actualizan la celda en su posición." wrapText="true" styleClass="subtitle" />
                    <CheckBox fx:id="chkBarras" text="Ver el arreglo como barras" />
                    <ScrollPane fx:id="scrollArreglo" fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" maxHeight="110">
                        <content><HBox fx:id="contenedorArreglo" alignment="BOTTOM_CENTER" spacing="8" /></content>
                    </ScrollPane>
                    <ScrollPane fx:id="scrollBarras" fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" prefHeight="200" visible="false" managed="false">
                        <content><HBox fx:id="contenedorBarras" alignment="BOTTOM_CENTER" spacing="6" /></content>
                    </ScrollPane>
                    <VBox fx:id="contenedorMatriz" alignment="CENTER" spacing="6" />
                    <Label fx:id="lblPaso" text="Prepara una entrada para empezar." wrapText="true" />
                    <Label fx:id="lblExplicacion" wrapText="true" />
                    <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT" columnHalignment="LEFT" rowValignment="CENTER">
                        <Button fx:id="btnAnterior" text="Anterior" onAction="#anterior" disable="true" />
                        <Button fx:id="btnSiguiente" text="Siguiente" onAction="#siguiente" disable="true" styleClass="primary-button" />
                        <Button fx:id="btnReproducir" text="Reproducir" onAction="#alternarReproduccion" disable="true" />
                        <Label text="Velocidad" />
                        <ComboBox fx:id="cmbVelocidad" prefWidth="240" accessibleText="Velocidad de reproducción" />
                    </FlowPane>
                </VBox>
                <VBox fx:id="panelPseudocodigo" spacing="8" styleClass="card" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.valignment="TOP" GridPane.vgrow="NEVER">
                    <Label text="Pseudocódigo" styleClass="section-title" />
                    <Label text="La línea resaltada es la que se ejecuta en el paso actual." wrapText="true" styleClass="subtitle" />
                    <VBox fx:id="listaPseudocodigo" spacing="2" styleClass="pseudocodigo" />
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
