<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.PracticaController">
    <content>
        <VBox spacing="18" styleClass="tab-content">
            <VBox spacing="10" styleClass="card">
                <Label text="Perfil y ejercicio" styleClass="section-title" />
                <HBox spacing="10">
                    <Label fx:id="lblPerfilActual" text="Perfil de la cuenta" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    <Button text="Actualizar" onAction="#recargar" />
                </HBox>
                <ComboBox fx:id="cmbEjercicio" promptText="Ejercicio guardado" maxWidth="Infinity" />
                <Label fx:id="lblEnunciado" text="Selecciona un ejercicio de la biblioteca." wrapText="true" />
            </VBox>
            <VBox spacing="10" styleClass="card">
                <Label text="Tu respuesta" styleClass="section-title" />
                <VBox fx:id="panelOrdenamiento" spacing="8">
                    <Label text="Escribe el arreglo final separado por comas." />
                    <TextField fx:id="txtRespuesta" promptText="Ej. 1, 2, 3" accessibleText="Respuesta del ejercicio" />
                </VBox>
                <VBox fx:id="panelMatriz" spacing="8" visible="false" managed="false">
                    <Label text="Aplica una operación elemental a la matriz inicial y escribe la matriz resultante completa." wrapText="true" />
                    <ComboBox fx:id="cmbOperacion" promptText="Elige la operación de filas" prefWidth="360" />
                    <Label fx:id="lblAyudaOperacion" wrapText="true" styleClass="subtitle" />
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox fx:id="campoDestino" spacing="4">
                            <Label fx:id="lblDestino" text="Fila destino" />
                            <TextField fx:id="txtDestino" promptText="1, 2…" prefWidth="110" maxWidth="110" />
                        </VBox>
                        <VBox fx:id="campoOrigen" spacing="4">
                            <Label fx:id="lblOrigen" text="Fila origen" />
                            <TextField fx:id="txtOrigen" promptText="1, 2…" prefWidth="110" maxWidth="110" />
                        </VBox>
                        <VBox fx:id="campoFactor" spacing="4">
                            <Label fx:id="lblFactor" text="Factor" />
                            <TextField fx:id="txtFactor" promptText="2, -1, 3/4…" prefWidth="130" maxWidth="130" />
                        </VBox>
                    </HBox>
                    <Label fx:id="lblFormula" styleClass="formula-operacion" wrapText="true" />
                    <VBox fx:id="entradaMatrizEscrita" />
                    <HBox spacing="10">
                        <Button fx:id="btnRestablecer" text="Restablecer matriz inicial" onAction="#restablecerMatriz" />
                    </HBox>
                </VBox>
                <HBox spacing="10">
                    <Button fx:id="btnVerificar" text="Verificar" onAction="#verificar" styleClass="primary-button" />
                </HBox>
                <Label fx:id="lblResultado" wrapText="true" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
