<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="tab-content" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.RankingController">
    <Label text="Ranking de estudiantes" styleClass="section-title" />
    <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar" styleClass="primary-button" />
    <Label fx:id="lblEstado" wrapText="true" />
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPosicion" text="Puesto" prefWidth="100" />
            <TableColumn fx:id="colPerfil" text="Perfil" prefWidth="240" />
            <TableColumn fx:id="colAciertos" text="Aciertos" prefWidth="130" />
            <TableColumn fx:id="colPorcentaje" text="Acierto %" prefWidth="150" />
        </columns>
    </TableView>
</VBox>
