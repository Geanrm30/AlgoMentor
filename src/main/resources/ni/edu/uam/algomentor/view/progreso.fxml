<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.ProgresoController">
    <Label text="Progreso de aprendizaje" styleClass="section-title" />
    <HBox spacing="10">
        <Label fx:id="lblPerfilActual" text="Perfil de la cuenta" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        <Button text="Actualizar" onAction="#verProgreso" styleClass="primary-button" />
        <Button fx:id="btnVistaPrevia" text="Vista previa" onAction="#previsualizarReporte" />
        <Button text="Exportar" onAction="#generarReporte" />
    </HBox>
    <FlowPane hgap="12" vgap="12">
        <VBox spacing="5" styleClass="summary-card" prefWidth="150">
            <Label text="Intentos" styleClass="summary-label" />
            <Label fx:id="lblIntentos" text="—" styleClass="summary-value" />
        </VBox>
        <VBox spacing="5" styleClass="summary-card" prefWidth="150">
            <Label text="Correctos" styleClass="summary-label" />
            <Label fx:id="lblCorrectos" text="—" styleClass="summary-value" />
        </VBox>
        <VBox spacing="5" styleClass="summary-card" prefWidth="150">
            <Label text="Incorrectos" styleClass="summary-label" />
            <Label fx:id="lblIncorrectos" text="—" styleClass="summary-value" />
        </VBox>
        <VBox spacing="5" styleClass="summary-card" prefWidth="150">
            <Label text="Acierto" styleClass="summary-label" />
            <Label fx:id="lblPorcentajeGeneral" text="—" styleClass="summary-value" />
        </VBox>
        <VBox spacing="5" styleClass="summary-card" prefWidth="150">
            <Label text="Racha de aciertos" styleClass="summary-label" />
            <Label fx:id="lblRacha" text="—" styleClass="summary-value" />
        </VBox>
        <VBox spacing="5" styleClass="summary-card" prefWidth="150">
            <Label text="Tiempo promedio" styleClass="summary-label" />
            <Label fx:id="lblTiempoPromedio" text="—" styleClass="summary-value" />
        </VBox>
    </FlowPane>
    <Label fx:id="lblResumen" text="Cargando progreso…" wrapText="true" />
    <TabPane VBox.vgrow="ALWAYS" styleClass="content-tabs">
        <tabs>
            <Tab text="Gráfico" closable="false">
                <content>
                    <BarChart fx:id="graficoHabilidades" animated="false" legendVisible="true">
                        <xAxis>
                            <CategoryAxis fx:id="axisHabilidad" label="Habilidad" tickLabelRotation="-25" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="axisCantidad" label="Evaluaciones" forceZeroInRange="true" />
                        </yAxis>
                    </BarChart>
                </content>
            </Tab>
            <Tab text="Detalle" closable="false">
                <content>
                    <TableView fx:id="tabla">
                        <columns>
                            <TableColumn fx:id="colHabilidad" text="Habilidad" prefWidth="200" />
                            <TableColumn fx:id="colAciertos" text="Aciertos" prefWidth="130" />
                            <TableColumn fx:id="colErrores" text="Errores" prefWidth="130" />
                            <TableColumn fx:id="colPorcentaje" text="Acierto %" prefWidth="240" />
                        </columns>
                    </TableView>
                </content>
            </Tab>
            <Tab text="Por algoritmo" closable="false">
                <content>
                    <VBox spacing="12">
                        <StackedBarChart fx:id="graficoAlgoritmos" animated="false" legendVisible="true" prefHeight="240" minHeight="200">
                            <xAxis>
                                <CategoryAxis fx:id="axisAlgoritmo" label="Algoritmo" tickLabelRotation="-15" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="axisIntentosAlgoritmo" label="Intentos" forceZeroInRange="true" />
                            </yAxis>
                        </StackedBarChart>
                        <TableView fx:id="tablaRendimiento" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRendAlgoritmo" text="Algoritmo" prefWidth="200" />
                                <TableColumn fx:id="colRendIntentos" text="Intentos" prefWidth="100" />
                                <TableColumn fx:id="colRendCorrectos" text="Correctos" prefWidth="110" />
                                <TableColumn fx:id="colRendIncorrectos" text="Incorrectos" prefWidth="110" />
                                <TableColumn fx:id="colRendPorcentaje" text="Acierto %" prefWidth="240" />
                            </columns>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
            <Tab text="Errores" closable="false">
                <content>
                    <VBox spacing="10">
                        <Label text="Cada error detectado en Práctica se clasifica por tipo y suma a una habilidad: signo en Signos, fracción en Fracciones, aritmético en Aritmética y operación inválida en Procedimiento." wrapText="true" />
                        <BarChart fx:id="graficoErrores" styleClass="grafico-errores" animated="false" legendVisible="false" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis fx:id="axisTipoError" label="Tipo de error" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="axisCantidadErrores" label="Errores" forceZeroInRange="true" />
                            </yAxis>
                        </BarChart>
                    </VBox>
                </content>
            </Tab>
            <Tab text="Evolución" closable="false">
                <content>
                    <LineChart fx:id="graficoEvolucion" animated="false" legendVisible="false" createSymbols="true">
                        <xAxis>
                            <NumberAxis fx:id="axisIntento" label="Intentos calificados (del más antiguo al más reciente)" forceZeroInRange="false" minorTickCount="0" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="axisAcierto" label="Acierto acumulado (%)" autoRanging="false" lowerBound="0" upperBound="100" tickUnit="25" />
                        </yAxis>
                    </LineChart>
                </content>
            </Tab>
            <Tab text="Resultados" closable="false">
                <content>
                    <PieChart fx:id="graficoResultados" styleClass="pie-resultados" animated="false" labelsVisible="false" legendVisible="true" legendSide="RIGHT" />
                </content>
            </Tab>
            <Tab text="Historial" closable="false">
                <content>
                    <TableView fx:id="tablaHistorial">
                        <columns>
                            <TableColumn fx:id="colHistFecha" text="Fecha" prefWidth="160" />
                            <TableColumn fx:id="colHistAlgoritmo" text="Algoritmo" prefWidth="190" />
                            <TableColumn fx:id="colHistModo" text="Modo" prefWidth="110" />
                            <TableColumn fx:id="colHistResultado" text="Resultado" prefWidth="120" />
                            <TableColumn fx:id="colHistDuracion" text="Duración" prefWidth="100" />
                        </columns>
                    </TableView>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
