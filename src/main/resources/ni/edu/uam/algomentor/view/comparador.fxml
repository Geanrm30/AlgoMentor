<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.algomentor.controller.ComparadorController">
    <Label text="Comparar ordenamientos" styleClass="section-title" />
    <Label text="Compara los métodos burbuja e inserción con los mismos números. Verás cuántas comparaciones, intercambios y pasos necesita cada uno." wrapText="true" />
    <HBox spacing="10">
        <TextField fx:id="txtDatos" promptText="Ej. 5, 1, 4, 2" accessibleText="Números enteros separados por coma" HBox.hgrow="ALWAYS" />
        <Button text="Comparar" onAction="#comparar" styleClass="primary-button" />
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAlgoritmo" text="Algoritmo" prefWidth="170" />
            <TableColumn fx:id="colComparaciones" text="Comparaciones" prefWidth="145" />
            <TableColumn fx:id="colIntercambios" text="Intercambios" prefWidth="135" />
            <TableColumn fx:id="colPasos" text="Pasos" prefWidth="100" />
            <TableColumn fx:id="colResultado" text="Resultado" prefWidth="220" />
        </columns>
    </TableView>
</VBox>
